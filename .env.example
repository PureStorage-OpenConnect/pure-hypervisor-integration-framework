# PHIF configuration — copy to `.env` and edit. NEVER commit your real `.env`.
#
# PHIF is unsupported/experimental software that can destroy data.
# Read DISCLAIMER.md before pointing it at real infrastructure.

# REQUIRED. Fernet key encrypting every stored array token and hypervisor
# credential. Generate once and keep it safe — if you lose it, all stored
# secrets become permanently unrecoverable.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PHIF_VAULT_MASTER_KEY=

# Stub ALL array and hypervisor I/O. Set to 1 to explore the entire UI and every
# workflow with no hardware and no risk. Strongly recommended for a first run.
PHIF_MOCK_MODE=1

# Database. Defaults to the Postgres service in docker-compose.yml.
# PHIF_DATABASE_URL=postgresql+psycopg://phif:phif@db:5432/phif

# JSON array of browser origins allowed to call the API.
# PHIF_CORS_ORIGINS=["https://phif.example.com"]

# vSphere Client Plugin container images. Both default to the public Docker Hub
# repositories, so "Install from Docker Hub" on the vSphere Plugin page works
# with no configuration. Override to move to a newer plugin release or to use a
# private registry mirror. Always include an explicit tag — these repositories
# publish no `latest`, so an untagged reference will not resolve.
# PHIF_VSPHERE_PLUGIN_IMAGE=everpure/client-plugin-vsphere:5.6.1
# PHIF_VSPHERE_PLUGIN_PROXY_IMAGE=everpure/client-plugin-vsphere-reverse-proxy:5.6.1
